{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "size": "node scripts/shell-size.mjs && size-limit",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@simuwork/ui": "*",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "size-limit": [
    {
      "name": "All JavaScript incl. lazy pages and languages (gzip)",
      "path": "dist/assets/*.js",
      "limit": "240 KB",
      "gzip": true
    },
    {
      "name": "CSS (gzip)",
      "path": "dist/assets/*.css",
      "limit": "30 KB",
      "gzip": true
    }
  ]
}
