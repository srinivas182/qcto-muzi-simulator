{
  "expo": {
    "name": "SimuWork",
    "slug": "simuwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mayuraconsultancy.simuwork",
      "infoPlist": {
        "NSCameraUsageDescription": "SimuWork uses the camera to scan your academy's QR codes and, when your academy requires it, for attendance check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mayuraconsultancy.simuwork",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "simuwork",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SimuWork uses the camera to scan your academy's QR codes and, when your academy requires it, for attendance check-in.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSize"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.simuwork.co.za",
      "webPortalDomain": "simuwork.co.za"
    }
  }
}
