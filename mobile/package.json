{
  "name": "simuwork-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@simuwork/core": "file:../packages/core",
    "@tanstack/query-async-storage-persister": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "expo": "~58.1.0",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.0",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.82.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "oxlint": "^1.95.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint app src test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "jest",
    "bundle": "expo export --platform android --output-dir dist/android",
    "size": "node scripts/bundle-size.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|@simuwork/.*|standard-navigation))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ]
  }
}
